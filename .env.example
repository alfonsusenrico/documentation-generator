# Required
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server
PORT=3000
PUBLIC_BASE_URL=

# Init (optional token for /api/init)
INIT_TOKEN=

# Agent API (for Jarvis/chat automation)
AGENT_TOKEN=

GITHUB_OWNER=alfonsusenrico

# Git identity (used if global git config is missing)
GIT_USER_NAME=
GIT_USER_EMAIL=

# Output language: en or id (template headings stay English; body follows this)
LANG=en

# Branding
PREPARED_BY=Alfonsus Enrico

# PDF (requires pandoc in PATH when enabled)
ENABLE_PDF=1
